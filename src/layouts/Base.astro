---
import '../styles/global.css';
import { business } from '../data/business';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isPreview = import.meta.env.SITE_ENV !== 'production';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    {isPreview && <div class="bg-amber-400 text-center text-sm font-semibold py-1">PREVIEW — not live</div>}
    <header class="border-b">
      <nav class="mx-auto max-w-6xl flex items-center justify-between px-4 py-3">
        <a href="/" class="font-bold text-lg text-brand">{business.name}</a>
        <a href="/get-offer/" class="rounded-lg bg-brand px-4 py-2 text-white font-semibold">Get my cash offer</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="mt-16 border-t bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-slate-600">
        <p>© {new Date().getFullYear()} {business.name}. We buy houses for cash across Dallas–Fort Worth.</p>
        <p class="mt-2"><a href="/we-buy-houses/">Areas we buy</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
      </div>
    </footer>
  </body>
</html>
